          },
          "start_date": {
            "description": "Date of the first plan day, YYYY-MM-DD (day N goes to start_date + N-1)",
            "type": "string"
          },
          "overwrite": {
            "description": "true: delete existing diary entries of the same meal types on the plan's dates before writing. false (default): leave those meals untouched and skip the plan meals for them.",
            "type": "boolean"
          }
        },
        "required": [
          "plan",
          "start_date"
        ],
