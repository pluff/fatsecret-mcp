# Secret used to seal (ChaCha20-Poly1305) auth codes, access/refresh tokens and registered
# client ids. Keep it stable: changing it invalidates every issued token. If unset, a random
# secret is generated at startup (with a warning) and all tokens die on restart.
# Generate via: openssl rand -hex 32
OAUTH_SECRET=

# Optional — HTTP listen port (default 8080).
PORT=8080

# Optional — public hostname (e.g. mcp.example.com) used for OAuth metadata/redirect URLs.
# If unset it is derived from X-Forwarded-Host / Host (and X-Forwarded-Proto).
# PUBLIC_HOST=

# Optional — redirect URIs clients may register / use (defaults to the Claude.ai/.com callbacks).
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Optional — pre-registered OAuth client. Not needed: clients register dynamically (/register).
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
